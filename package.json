{
  "name": "mathcompile",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.app.json && vite build",
    "check": "svelte-check --tsconfig ./tsconfig.app.json",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:perf": "playwright test -c playwright.perf.config.ts",
    "docs:pdf": "node scripts/build-reference-pdf.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "marked": "^18.0.14",
    "oxlint": "^1.81.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@cortex-js/compute-engine": "^0.133.0",
    "nerdamer": "^1.1.13"
  }
}
